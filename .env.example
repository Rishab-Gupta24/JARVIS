# Long random string. The iPhone Shortcut and web app send it as "Authorization: Bearer <token>".
# Generate one with:  .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(32))"
JARVIS_TOKEN=change-me
# Shorter token for the iPhone Shortcuts, and Jarvis's address on your tailnet;
# both written by `python -m jarvis phone-setup`.
JARVIS_PHONE_TOKEN=
JARVIS_PUBLIC_URL=
# Read-only token inside the calendar.ics subscription address.
JARVIS_FEED_TOKEN=

OLLAMA_URL=http://127.0.0.1:11434
# qwen3:8b fits the 8 GB RTX 5050; use qwen3:4b if Whisper needs the room.
OLLAMA_MODEL=qwen3:8b

# Reads photos and scanned PDFs. ~6 GB; Ollama swaps it with the main model as needed.
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# Voice (python -m jarvis voice). Models download into data/models on first use.
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=int8_float16
# kokoro (natural, ~1 s per sentence on CPU) or piper (instant, rougher)
TTS_ENGINE=kokoro
# kokoro: bm_george, bm_fable, bm_lewis, bf_emma, af_heart...  piper: en_GB-alan-medium
TTS_VOICE=bm_george
WAKE_THRESHOLD=0.4
# Leave empty for the Windows default microphone; `python -m jarvis devices` lists them.
MIC_DEVICE=

# Festivals and public holidays downloaded into the calendar (this year and next), refreshed weekly.
# Comma-separated: india, uae, uk, usa, pakistan, nepal, bangladesh, sri lanka, saudi arabia, singapore.
# Leave empty to turn it off.
HOLIDAY_REGIONS=india,uae
HOLIDAY_REFRESH_DAYS=7

JARVIS_DB=data/jarvis.db
# Originals of every file sent to Jarvis, and a folder it watches for new files.
JARVIS_FILES=data/files
JARVIS_INBOX=inbox
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
JARVIS_TZ=Asia/Dubai

# Coding (python -m jarvis.coder) and the game studio (python -m jarvis.studio)
# JARVIS_NEW_PROJECTS_DIR=C:\Users\you\Projects
# JARVIS_CODER=claude           # claude = Claude Code (default); local = Jarvis's own coder
# CODER_MODEL=qwen2.5-coder:7b
# STUDIO_PLANNER_MODEL=qwen3:8b  # researcher, planner and reviewer
# STUDIO_CODER_MODEL=           # tester and coder; empty = the planner model (no GPU swaps, Jarvis stays responsive)
# STUDIO_THINKER_MODEL=         # plan, design, split, test check with thinking on; empty = the planner model (qwen3:14b was 7x slower here)
# OLLAMA_NUM_CTX=16384          # context for every request; needs OLLAMA_FLASH_ATTENTION=1 and OLLAMA_KV_CACHE_TYPE=q8_0 set for Ollama itself
# STUDIO_PLUGINS=ponytail,test_first,review,playtest,vision,phone_updates   # vision = qwen2.5vl reviews screenshots
# STUDIO_PONYTAIL=full          # lite (rules only) / full (rules + checks) / ultra / off
# STUDIO_HOURS=6                # time budget per run; resume carries on
# STUDIO_HELPER=claude          # ask Claude Code when stuck (sees only the game's folder), or none
# STUDIO_HELPER_CALLS=3         # Claude Code calls per project, after test checks and task splitting

# Looking things up online (look_up): only the search words leave the PC. Wikipedia only answers clients that
# give a contact; put one here (e.g. your GitHub page) to get its summaries, or leave empty to use search snippets.
# JARVIS_WEB_CONTACT=
